# SaaS Spend Track — environment variables for the Cloudflare Pages project.
# These are set in the Cloudflare dashboard (Settings → Variables), NOT committed.
# Copy this file's keys; never put real secret values in a tracked file.

# --- Bindings (not env vars) ---
# D1 database binding named exactly: DB  (database: sst-trial)

# --- URLs / identity ---
APP_URL=https://app.saasspendtrack.com
FROM_EMAIL=hello@saasspendtrack.com
FROM_NAME=SaaS Spend Track
REPLY_TO=hello@saasspendtrack.com

# --- Email (Zoho ZeptoMail) ---
ZEPTOMAIL_URL=https://api.zeptomail.in/v1.1/email   # .com for non-India Zoho
ZEPTOMAIL_TOKEN=                                     # SECRET — ZeptoMail Send Mail API key

# --- Payments (Razorpay) ---
RAZORPAY_WEBHOOK_SECRET=                             # SECRET — must match the Razorpay webhook secret

# --- RB2B visitor ingest ---
RB2B_INGEST_SECRET=                                  # SECRET — bearer token for POST /api/rb2b/ingest (set the same value in your Make/Zapier POST header)

# --- Admin + cadence ---
ADMIN_EMAILS=you@example.com                         # comma-separated owner emails (admin panel + excluded from funnel)
USD_INR=86                                           # FX rate for showing USD revenue in INR
CRON_SECRET=                                         # SECRET — guards /api/cron/tick; same value in the cron worker

# --- AI features (optional; existing endpoints) ---
ANTHROPIC_API_KEY=                                   # SECRET — enables /api/extract, /api/ask, /api/renewal-guide
# EXTRACT_MODEL=                                      # optional model override; otherwise auto-discovers newest Sonnet
